{
  "name": "how-high-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=${DATA_DIR:-../local-data} tsx watch src/index.ts",
    "analyze": "DATA_DIR=${DATA_DIR:-../local-data} tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "better-sqlite3": "^11.10.0",
    "fast-xml-parser": "^5.2.0",
    "fastify": "^5.12.5",
    "geotiff": "^3.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pngjs": "^7.0.0",
    "proj4": "^2.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
