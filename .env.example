# Timezone for container clocks.
TZ=Europe/Zurich

# User/group id the backend process runs as after startup (linuxserver-style).
# On the NAS, match the uid/gid that owns your Docker config volumes.
PUID=1000
PGID=1000

# Host port the frontend (nginx) publishes, for Nginx Proxy Manager to point at.
FRONTEND_PORT=8421

# Where the backend's persistent data lives on the host: the SQLite DB,
# uploaded GPX files and the terrain tile cache (roughly 1 MB per km² of
# Swiss terrain touched). Defaults to a local ./data folder; on a
# NAS/Portainer deployment, set this to wherever you keep other services'
# persistent config.
DATA_PATH=./data

# Google Maps API key for scoring routes from shared Google Maps links (car,
# bus, train). Needs a Google Cloud project with billing and the Routes API
# enabled; restrict the key to the Routes API. Leave unset to disable link
# support entirely: GPX hikes work without it.
GOOGLE_MAPS_API_KEY=
